# Build output
backend/build/
backend/.gradle/
frontend/dist/
frontend/node_modules/

# Large derived data artifacts -- regenerated by the bootstrap job
data/raw/
data/*.tif
data/*.zip

# Local env
.env
.env.local

# Editors / OS
.idea/
.vs/
*.iml
.DS_Store

# Local DB credentials -- never committed
backend/src/main/resources/application-local.yml

# Local tooling config -- contains machine-specific absolute paths
.claude/

# Exported static site data (regenerated by the pipeline)
site-data/

# A local copy of the static export, for running the site without a database.
# Copy backend/build/site-data here and start the dev server with
# VITE_DATA_MODE=static; see .claude/launch.json.
frontend/public/data/
